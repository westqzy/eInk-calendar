# 打开输入文件和输出文件
input_filename = "D:/20220728/RX_FLOW_TEST/singtone_384k_band20M_1fn.dat"
output_filename = "D:/20220728/RX_FLOW_TEST/output.txt"

with open(input_filename, "r") as input_file, open(output_filename, "w") as output_file:
    # 逐行处理输入文件内容
    for line in input_file:
        # 去掉(UINT32)并移除末尾的逗号
        modified_line = line.replace("(UINT32)", "")
        modified_line = modified_line.replace(",", "")
        # 将处理后的行写入输出文件
        output_file.write(modified_line)

print("处理完成，已生成新文件：", output_filename)
